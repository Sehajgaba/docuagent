# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — your real keys never get committed.

# --- NVIDIA NIM (https://build.nvidia.com) ---
# Primary provider: embeddings (llama-3.2-nv-embedqa-1b-v1) + chat/agent LLM
# (deepseek-v4-pro-0813), one key, one OpenAI-compatible endpoint.
NVIDIA_API_KEY=your_nvidia_key_here

# --- Gemini (Google AI Studio: https://aistudio.google.com/app/apikey) ---
# Unused by default — kept as a fallback provider only.
GEMINI_API_KEY=

# --- Qdrant ---
# Local Docker dev: leave URL as localhost, no API key needed.
# Qdrant Cloud (for live deploy): set the cluster URL + key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LangSmith (observability, Day 10) — optional until then ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docuagent
